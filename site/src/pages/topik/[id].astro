---
import Base from '../../layouts/Base.astro';
import { topics, topicById, standardById, prereqsOf, unlocksOf, ancestors, mapelByCode, kelasLabel, TYPE_LABEL, FASE_KELAS } from '../../lib/data';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const m = mapelByCode.get(t.mapel)!;
const pre = prereqsOf(t.id).sort((a, b) => (a.strength === b.strength ? 0 : a.strength === 'wajib' ? -1 : 1));
const next = unlocksOf(t.id);
const allBefore = ancestors(t.id).size;
// Highlight every phrase this topic serves inside the verbatim CP text.
const cpBlocks = t.standards.map((sid) => {
  const s = standardById.get(sid)!;
  const phrases = t.cp.filter((c) => c.standard === sid).map((c) => c.phrase);
  const marks: [number, number][] = [];
  for (const p of phrases) { const i = s.text.indexOf(p); if (i >= 0) marks.push([i, i + p.length]); }
  marks.sort((a, b) => a[0] - b[0]);
  const parts: { text: string; hit: boolean }[] = [];
  let at = 0;
  for (const [a, b] of marks) {
    if (a < at) { if (b > at) { parts.push({ text: s.text.slice(at, b), hit: true }); at = b; } continue; }
    if (a > at) parts.push({ text: s.text.slice(at, a), hit: false });
    parts.push({ text: s.text.slice(a, b), hit: true });
    at = b;
  }
  if (at < s.text.length) parts.push({ text: s.text.slice(at), hit: false });
  return { s, parts };
});
const promptParts = t.parentPrompt.split('{{nama}}');
const desc = `${t.name} — ${t.description}`.slice(0, 155);
---
<Base title={t.name} description={desc} path={`/topik/${t.id}/`}>
  <nav class="crumbs small" aria-label="Lokasi">
    <a href={`/mapel/${t.mapel}/`}>{m.name}</a> › <a href={`/mapel/${t.mapel}/#fase-${t.fase}`}>Fase {t.fase}</a> › <span>{t.elemen}</span>
  </nav>
  <h1>{t.name}</h1>
  <div class="chips meta">
    <span class="chip tint">{kelasLabel(t.kelas)} (perkiraan)</span>
    <span class="chip">Fase {t.fase} · {FASE_KELAS[t.fase]}</span>
    <span class="chip">{TYPE_LABEL[t.type] ?? t.type}</span>
  </div>
  <p class="lead">{t.description}</p>

  <section class="card try stack" style="--gap: 12px">
    <h2>Coba di rumah</h2>
    <label class="small muted" for="nama">Nama anak (tidak disimpan)</label>
    <input id="nama" type="text" placeholder="Nama anak" autocomplete="off" maxlength="40" />
    <p class="prompt">
      {promptParts.map((p, i) => <>{p}{i < promptParts.length - 1 && <span class="nama">anak Anda</span>}</>)}
    </p>
  </section>

  <section class="stack block" style="--gap: 10px">
    <h2>Tanda anak sudah bisa</h2>
    <ul class="checks">{t.evidence.map((e) => <li>{e}</li>)}</ul>
  </section>

  <section class="stack block" style="--gap: 10px">
    <h2>Perlu dikuasai dulu</h2>
    {pre.length ? (
      <>
        <ul class="list">
          {pre.map((d) => {
            const p = topicById.get(d.requires)!;
            return (
              <li><a href={`/topik/${p.id}/`}>
                <span class="k">{kelasLabel(p.kelas)}</span>
                <span class="t">{p.name}{p.mapel !== t.mapel && <> · <span class="muted">{mapelByCode.get(p.mapel)?.short}</span></>}<span class="why">{d.reason}</span></span>
                <span class:list={['s', d.strength]}>{d.strength === 'wajib' ? 'Wajib' : 'Membantu'}</span>
              </a></li>
            );
          })}
        </ul>
        {allBefore > pre.length && <p class="small muted">Seluruhnya ada {allBefore} topik di jalur sebelum topik ini. <a href={`/graf/#${t.id}`}>Lihat di graf</a>.</p>}
      </>
    ) : <p class="muted">Ini titik awal. Tidak ada topik lain yang harus dikuasai lebih dulu.</p>}
  </section>

  <section class="stack block" style="--gap: 10px">
    <h2>Membuka jalan ke</h2>
    {next.length ? (
      <ul class="list">
        {next.map((d) => {
          const n = topicById.get(d.topic)!;
          return <li><a href={`/topik/${n.id}/`}><span class="k">{kelasLabel(n.kelas)}</span><span class="t">{n.name}{n.mapel !== t.mapel && <> · <span class="muted">{mapelByCode.get(n.mapel)?.short}</span></>}</span></a></li>;
        })}
      </ul>
    ) : <p class="muted">Belum ada topik lanjutan di peta ini.</p>}
  </section>

  <section class="stack block" style="--gap: 10px">
    <h2>Dari Capaian Pembelajaran</h2>
    {cpBlocks.map(({ s, parts }) => (
      <figure class="grouped quote">
        <blockquote>{parts.map((p) => (p.hit ? <mark>{p.text}</mark> : p.text))}</blockquote>
        <figcaption class="small muted">{s.elemen}, Fase {s.fase} · Keputusan Kepala BSKAP {s.source.decree}, Lampiran {s.source.lampiran}</figcaption>
      </figure>
    ))}
  </section>

  <p class="notice block">
    Draf AI — topik ini disusun dengan bantuan AI dari teks Capaian Pembelajaran dan belum ditinjau guru. Bukan
    penilaian resmi.
  </p>
</Base>

<style>
  .crumbs { color: var(--label-3); margin-bottom: 10px; }
  .crumbs a { color: var(--label-2); }
  .meta { margin-top: 14px; }
  .try { margin-top: 28px; }
  .prompt { font-size: 19px; line-height: 1.45; }
  .nama { font-weight: 600; color: var(--tint); }
  .block { margin-top: 36px; }
  .checks { margin: 0; padding-left: 22px; display: grid; gap: 6px; }
  .quote { margin: 0; }
  .quote blockquote { margin: 0 0 8px; line-height: 1.55; }
</style>

<script>
  const input = document.getElementById('nama') as HTMLInputElement;
  const slots = [...document.querySelectorAll<HTMLSpanElement>('.nama')];
  input.addEventListener('input', () => {
    const v = input.value.trim();
    for (const s of slots) s.textContent = v || 'anak Anda';
  });
</script>
